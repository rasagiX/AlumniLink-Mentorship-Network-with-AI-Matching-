# Must be IDENTICAL to SECRET_KEY in the FastAPI backend's .env — Next.js
# never mints session tokens itself, only verifies the ones FastAPI issues.
JWT_SECRET="dev-only-insecure-secret-change-me-before-deploying"

# Where the FastAPI backend is running. Auth API routes under app/api/auth/*
# proxy to this (server-to-server, so no CORS involved).
FASTAPI_BASE_URL="http://localhost:8000"
