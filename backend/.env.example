# Dev-only secret used to sign session JWTs. This MUST be identical to the
# JWT_SECRET the Next.js frontend uses (see alumnilink/.env), since the
# frontend verifies tokens minted here without calling back to this API.
# Replace with a long random string before deploying (e.g. `openssl rand -hex 32`).
SECRET_KEY=dev-only-insecure-secret-change-me-before-deploying

DATABASE_URL=postgresql+psycopg2://alumnilink:alumnilink_dev_pw@localhost:5432/alumnilink
